<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Gastapp.Pages.Menu.SettingsPage"
             x:Name="Root"
             xmlns:vm="clr-namespace:Gastapp.ViewModels"
             xmlns:dtos="clr-namespace:Gastapp.Models.Models;assembly=Gastapp.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="vm:SettingsViewModel">
    <ContentView.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{StaticResource SurfaceSecondary}" Offset="0.0" />
            <GradientStop Color="White" Offset="1.0" />
        </LinearGradientBrush>
    </ContentView.Background>
    <ScrollView>
        <VerticalStackLayout Padding="20, 18, 20, 28" Spacing="16">
            <Border BackgroundColor="{StaticResource ButtonsGreen}" StrokeThickness="0" StrokeShape="RoundRectangle 28" Padding="20">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Ajustes" FontSize="28" TextColor="White" />
                    <Label Text="{Binding ScreenSubtitle}" FontFamily="OpenSansRegular" FontSize="14" TextColor="White" Opacity="0.92" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" Stroke="{StaticResource BorderSubtle}" StrokeShape="RoundRectangle 24" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Recordatorios" FontSize="22" TextColor="{StaticResource TextDarkColor}" />
                    <Label Text="{Binding NotificationsStatusText}" FontFamily="OpenSansRegular" TextColor="{StaticResource Gray500}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="Activar recordatorios" VerticalOptions="Center" FontSize="16" TextColor="{StaticResource TextDarkColor}" />
                        <Switch Grid.Column="1" IsToggled="{Binding IsRemindersEnabled}" />
                    </Grid>

                    <Picker Title="Frecuencia de recordatorios"
                            ItemsSource="{Binding ReminderFrequencyOptions}"
                            ItemDisplayBinding="{Binding Label}"
                            SelectedItem="{Binding SelectedReminderFrequencyOption}"
                            IsEnabled="{Binding IsRemindersEnabled}" />

                    <Button Text="Activar notificaciones del sistema"
                            IsVisible="{Binding ShowEnableNotificationsButton}"
                            Command="{Binding EnableSystemNotificationsCommand}"
                            BackgroundColor="{StaticResource ButtonsGreen}"
                            TextColor="White" />

                    <Label Text="Se guardan automáticamente al cambiar la frecuencia o activación."
                           FontFamily="OpenSansRegular"
                           TextColor="{StaticResource Gray500}" />

                    <Button Text="Enviar notificación de prueba"
                            Command="{Binding SendTestNotificationCommand}"
                            BackgroundColor="White"
                            TextColor="{StaticResource ButtonsGreen}"
                            BorderColor="{StaticResource ButtonsGreen}"
                            BorderWidth="1" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" Stroke="{StaticResource BorderSubtle}" StrokeShape="RoundRectangle 24" Padding="18">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenCreditCardsPageCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                        <Label Text="Mis tarjetas de crédito" FontSize="22" TextColor="{StaticResource TextDarkColor}" />
                        <Label Text="{Binding CreditCardsSummaryText}" FontFamily="OpenSansRegular" TextColor="{StaticResource Gray500}" />
                        <Label Text="Administra saldos, cortes y compras a MSI desde tu Wallet." FontFamily="OpenSansRegular" FontSize="12" TextColor="{StaticResource Gray500}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" BackgroundColor="{StaticResource ButtonsGreen}" StrokeThickness="0" StrokeShape="RoundRectangle 22" HeightRequest="44" WidthRequest="44" VerticalOptions="Center">
                        <Label Style="{StaticResource FaIconLabel}" Text="{StaticResource IconChevronRight}" TextColor="White" FontSize="16" />
                    </Border>
                </Grid>
            </Border>

<!-- Dispositivos vinculados (relojes Wear OS) -->
            <Border BackgroundColor="White" Stroke="{StaticResource BorderSubtle}" StrokeShape="RoundRectangle 24" Padding="18">
                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                            <Label Text="Dispositivos" FontSize="22" TextColor="{StaticResource TextDarkColor}" />
                            <Label Text="{Binding DevicesSummaryText}" FontFamily="OpenSansRegular" TextColor="{StaticResource Gray500}" />
                            <Label Text="Vincula tu reloj para registrar gastos por voz sin sacar el teléfono."
                                   FontFamily="OpenSansRegular" FontSize="12" TextColor="{StaticResource Gray500}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" BackgroundColor="{StaticResource AccentSoft}" StrokeThickness="0"
                                StrokeShape="RoundRectangle 22" HeightRequest="44" WidthRequest="44" VerticalOptions="Center">
                            <Label Style="{StaticResource FaIconLabel}" Text="{StaticResource IconStopwatch}"
                                   TextColor="{StaticResource ButtonsGreen}" FontSize="18" />
                        </Border>
                    </Grid>

                    <ActivityIndicator IsVisible="{Binding IsLoadingDevices}" IsRunning="{Binding IsLoadingDevices}"
                                       Color="{StaticResource ButtonsGreen}" HeightRequest="22" HorizontalOptions="Start" />

                    <VerticalStackLayout Spacing="8" IsVisible="{Binding HasLinkedDevices}"
                                         BindableLayout.ItemsSource="{Binding LinkedDevices}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dtos:DeviceDto">
                                <Border BackgroundColor="{StaticResource SurfaceSecondary}" Stroke="{StaticResource BorderSubtle}"
                                        StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="14,12">
                                    <Grid ColumnDefinitions="26, *, Auto" ColumnSpacing="10">
                                        <Label Grid.Column="0" Style="{StaticResource FaIconLabel}"
                                               Text="{StaticResource IconStopwatch}" FontSize="15"
                                               TextColor="{StaticResource NavInactiveText}" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold"
                                                   TextColor="{StaticResource TextDarkColor}" />
                                            <Label Text="{Binding LastSeenAt, StringFormat='Última conexión: {0:dd/MMM/yyyy HH:mm}'}"
                                                   FontFamily="OpenSansRegular" FontSize="11.5"
                                                   TextColor="{StaticResource Gray500}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="2" Text="Quitar"
                                                FontSize="12" HeightRequest="36" Padding="14,0" CornerRadius="12"
                                                BackgroundColor="{StaticResource ButtonsLightGray}"
                                                TextColor="{StaticResource ErrorColor}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=RevokeDeviceCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Button Text="Vincular reloj" Command="{Binding LinkDeviceCommand}"
                            IsEnabled="{Binding IsLoadingDevices, Converter={toolkit:InvertedBoolConverter}}" />

                </VerticalStackLayout>
            </Border>

                        <!-- Copia de seguridad y Respaldo local (Herramienta temporal / Dev) -->
            <Border IsVisible="{Binding IsBackupToolsVisible}" BackgroundColor="White" Stroke="{StaticResource BorderSubtle}" StrokeShape="RoundRectangle 24" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Copia de seguridad local" FontSize="22" TextColor="{StaticResource TextDarkColor}" />
                            <Label Text="Exporta o restaura tu base de datos SQLite local para no perder tus datos al cambiar de servidor API." FontFamily="OpenSansRegular" TextColor="{StaticResource Gray500}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" BackgroundColor="#E8F0FE" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="8,4" VerticalOptions="Start">
                            <Label Text="Dev / Temp" FontSize="11" TextColor="#1A73E8" FontAttributes="Bold" />
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,4,0,0">
                        <Button Grid.Column="0" Text="Exportar SQLite (.db)"
                                Command="{Binding ExportDatabaseCommand}"
                                IsEnabled="{Binding IsBackupBusy, Converter={toolkit:InvertedBoolConverter}}"
                                BackgroundColor="{StaticResource ButtonsGreen}"
                                TextColor="White"
                                HeightRequest="44"
                                FontSize="12"
                                FontAttributes="Bold">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="FaSolid" Glyph="{StaticResource IconBox}" Color="White" Size="14" />
                            </Button.ImageSource>
                        </Button>

                        <Button Grid.Column="1" Text="Exportar JSON"
                                Command="{Binding ExportJsonCommand}"
                                IsEnabled="{Binding IsBackupBusy, Converter={toolkit:InvertedBoolConverter}}"
                                BackgroundColor="{StaticResource SurfaceSecondary}"
                                TextColor="{StaticResource TextDarkColor}"
                                BorderColor="{StaticResource BorderSubtle}"
                                BorderWidth="1"
                                HeightRequest="44"
                                FontSize="12"
                                FontAttributes="Bold">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="FaSolid" Glyph="{StaticResource IconFileLines}" Color="{StaticResource TextDarkColor}" Size="14" />
                            </Button.ImageSource>
                        </Button>
                    </Grid>

                    <Button Text="Importar / Restaurar Respaldo (.db o .json)"
                            Command="{Binding RestoreBackupCommand}"
                            IsEnabled="{Binding IsBackupBusy, Converter={toolkit:InvertedBoolConverter}}"
                            BackgroundColor="#EAF6F0"
                            TextColor="{StaticResource ButtonsGreen}"
                            BorderColor="{StaticResource ButtonsGreen}"
                            BorderWidth="1"
                            HeightRequest="42"
                            FontSize="13"
                            FontAttributes="Bold">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FaSolid" Glyph="{StaticResource IconDownload}" Color="{StaticResource ButtonsGreen}" Size="14" />
                        </Button.ImageSource>
                    </Button>

                    <Grid IsVisible="{Binding IsBackupBusy}" ColumnDefinitions="Auto, *" ColumnSpacing="10" Margin="0,2,0,0">
                        <ActivityIndicator Grid.Column="0" IsRunning="{Binding IsBackupBusy}" Color="{StaticResource ButtonsGreen}" WidthRequest="20" HeightRequest="20" />
                        <Label Grid.Column="1" Text="{Binding BackupStatusText}" FontSize="12" TextColor="{StaticResource ButtonsGreen}" FontAttributes="Bold" FontFamily="OpenSansRegular" VerticalOptions="Center" />
                    </Grid>

                    <Label FontSize="11" TextColor="{StaticResource Gray500}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{StaticResource IconLightbulb}" FontFamily="FaSolid" />
                                <Span Text="  Tip: El diálogo te permitirá compartir o guardar el archivo directamente en Google Drive, WhatsApp, correo o descargas para restaurarlo en cualquier momento." FontFamily="OpenSansRegular" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#FFF1F1" Stroke="#F5CDCD" StrokeShape="RoundRectangle 24" Padding="18">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Cerrar sesión" FontSize="22" TextColor="{StaticResource TextDarkColor}" />
                    <Label Text="Usa esta acción cuando quieras salir del dispositivo actual. Borrará la sesión local para proteger tu información." FontFamily="OpenSansRegular" TextColor="{StaticResource Gray500}" />
                    <Button Text="Cerrar sesión" Command="{Binding LogoutCommand}" BackgroundColor="{StaticResource ErrorColor}" TextColor="White" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>