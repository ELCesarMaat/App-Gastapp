<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0-android</TargetFrameworks>
		<!-- iOS y MacCatalyst están fuera de soporte - descomentar si es necesario actualizar a net9.0 -->
		<!-- <TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks> -->
		<!--<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net8.0-windows10.0.19041.0</TargetFrameworks>-->
		
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net8.0-tizen</TargetFrameworks> -->

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>Gastapp</RootNamespace>
		<UseMaui>true</UseMaui>
		<CheckEolTargetFramework>false</CheckEolTargetFramework>
		<NoWarn>$(NoWarn);NETSDK1202</NoWarn>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>Gastapp</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.binc.gastapp</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0.4-alpha1</ApplicationDisplayVersion>
		<!-- Respaldo. En Release se sobreescribe con el numero de commits de git,
		     que es lo unico que garantiza que siempre suba. El ultimo publicado fue 120,
		     asi que este valor nunca debe quedar por debajo. -->
		<ApplicationVersion>127</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">11.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
	</PropertyGroup>


	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net8.0-android|AnyCPU'">
	  <AndroidPackageFormat>apk</AndroidPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#C9F5D8" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#C9F5D8" BaseSize="160,160" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="Resources\Images\icons\about_icon.svg" />
	  <None Remove="Resources\Images\icons\backup_icon.svg" />
	  <None Remove="Resources\Images\icons\contact_icon.svg" />
	  <None Remove="Resources\Images\icons\import_icon.svg" />
	  <None Remove="Resources\Images\icons\logout_icon.svg" />
	  <None Remove="Resources\Images\icons\profile_icon.svg" />
	  <None Remove="Resources\Images\icons\saves_icon.svg" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="9.1.1" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="FluentValidation" Version="12.0.0" />
		<PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.4" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
		<PackageReference Include="Plugin.LocalNotification" Version="11.1.0" />
		<PackageReference Include="Refit" Version="8.0.0" />
		<PackageReference Include="Refit.HttpClientFactory" Version="8.0.0" />
		<PackageReference Include="Syncfusion.Maui.Buttons" Version="29.1.39" />
		<PackageReference Include="Syncfusion.Maui.Calendar" Version="29.1.39" />
		<PackageReference Include="Syncfusion.Maui.Charts" Version="29.1.39" />
		<PackageReference Include="Syncfusion.Maui.Core" Version="29.1.39" />
		<PackageReference Include="Syncfusion.Maui.ProgressBar" Version="29.1.39" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.10.0" />
		<PackageReference Include="The49.Maui.BottomSheet" Version="8.0.3" />
	</ItemGroup>

	<!--
		Wearable Data Layer: el canal con la app del reloj. Es un binding de
		play-services-wearable y solo existe para Android, por eso va condicionado.

		Version clavada a 118.2.0.3 a proposito: es la ultima que soporta
		net8.0-android34.0. De 119 en adelante exigen net9.0-android35.0, asi que no
		se puede subir sin migrar el proyecto entero a .NET 9.
	-->
	<ItemGroup Condition="$(TargetFramework.Contains('-android'))">
		<PackageReference Include="Xamarin.GooglePlayServices.Wearable" Version="118.2.0.3" />

		<!--
			NO QUITAR NINGUNO DE ESTOS.

			El binding de Wearable sube varios paquetes de AndroidX, pero los
			artefactos "-ktx" se quedaban en su version vieja. A partir de AndroidX
			Collection 1.4 y Lifecycle 2.8 las extensiones Kotlin se fusionaron dentro
			del artefacto principal, asi que el jar viejo y el nuevo declaran las
			mismas clases y D8 revienta con "Type ... is defined multiple times".

			Fijarlos a la version alineada los deja como stubs que solo dependen del
			artefacto principal. Si algun dia se sube el binding, hay que subir estos
			en el mismo commit.
		-->
		<PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.4.5.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.8.7.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" Version="2.8.7.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.8.7.1" />
		<PackageReference Include="Xamarin.AndroidX.Activity.Ktx" Version="1.9.3.1" />
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.8.5.1" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Pages\Register\RegisterSalary.xaml.cs">
	    <DependentUpon>RegisterSalary.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="StartPage.xaml.cs">
	    <DependentUpon>StartPage.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Pages\Register\RegisterName.xaml.cs">
	    <DependentUpon>RegisterName.xaml</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
		<MauiFont Include="Resources/Fonts/Baloo-Regular.ttf" Alias="BalooRegular" />
	</ItemGroup>

	<ItemGroup>
	  <MauiImage Include="Resources\Images\icons\about_icon.svg" />
	  <MauiImage Include="Resources\Images\icons\backup_icon.svg" />
	  <MauiImage Include="Resources\Images\icons\contact_icon.svg" />
	  <MauiImage Include="Resources\Images\icons\import_icon.svg" />
	  <MauiImage Include="Resources\Images\icons\logout_icon.svg" />
	  <MauiImage Include="Resources\Images\icons\profile_icon.svg" />
	  <MauiImage Include="Resources\Images\icons\saves_icon.svg" />
	</ItemGroup>

	<ItemGroup>
