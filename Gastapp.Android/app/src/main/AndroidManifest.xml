<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Para instalar las actualizaciones que se bajan de GitHub Releases. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        Sin usesCleartextTraffic: el API es HTTPS. Para apuntar a una API local por http
        hay una configuracion de red solo para debug en src/debug.

        allowBackup="false": los datos viven en la nube y se bajan al iniciar sesion;
        restaurar una base o una sesion vieja desde el respaldo de Google solo traeria
        datos desfasados.
    -->
    <application
        android:name=".GastappApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gastapp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Gastapp.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Para abrir el APK de actualizacion descargado (misma autoridad que en MAUI). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.binc.gastapp.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
