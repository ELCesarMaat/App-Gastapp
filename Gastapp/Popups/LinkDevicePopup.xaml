<?xml version="1.0" encoding="utf-8"?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="Gastapp.Popups.LinkDevicePopup"
               CanBeDismissedByTappingOutsideOfPopup="True"
               Color="Transparent">

    <Border x:Name="Card"
            BackgroundColor="{StaticResource SurfacePrimary}"
            StrokeShape="RoundRectangle 24"
            Stroke="{StaticResource BorderSubtle}"
            StrokeThickness="1"
            Padding="24,24,24,20"
            WidthRequest="310"
            HorizontalOptions="Center">

        <Border.Shadow>
            <Shadow Brush="Black" Offset="0,6" Radius="20" Opacity="0.12" />
        </Border.Shadow>

        <VerticalStackLayout Spacing="0">

            <!-- Insignia: cambia a palomita cuando el reloj queda vinculado -->
            <Border x:Name="BadgeBorder"
                    StrokeShape="RoundRectangle 28"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource AccentSoft}"
                    HeightRequest="56"
                    WidthRequest="56"
                    HorizontalOptions="Center"
                    Margin="0,0,0,14">
                <Label x:Name="BadgeIcon"
                       Text="{StaticResource IconLink}"
                       Style="{StaticResource FaIconLabel}"
                       FontSize="24"
                       TextColor="{StaticResource ButtonsGreen}" />
            </Border>

            <Label x:Name="TitleLabel"
                   Text="Vincular reloj"
                   FontFamily="BalooRegular"
                   FontSize="19"
                   TextColor="{StaticResource TextDarkColor}"
                   HorizontalTextAlignment="Center" />

            <Label x:Name="MessageLabel"
                   Text="Abre Gastapp en tu reloj. Se vinculará solo, sin escribir ningún código."
                   FontFamily="OpenSansRegular"
                   FontSize="13"
                   TextColor="{StaticResource NavInactiveText}"
                   HorizontalTextAlignment="Center"
                   Margin="0,6,0,0" />

            <!-- Espera activa -->
            <HorizontalStackLayout x:Name="WaitingRow"
                                   HorizontalOptions="Center"
                                   Spacing="10"
                                   Margin="0,18,0,0">
                <ActivityIndicator x:Name="BusyIndicator"
                                   IsRunning="True"
                                   Color="{StaticResource ButtonsGreen}"
                                   HeightRequest="18"
                                   WidthRequest="18"
                                   VerticalOptions="Center" />
                <Label x:Name="WaitingLabel"
                       Text="Esperando al reloj..."
                       FontFamily="OpenSansRegular"
                       FontSize="12.5"
                       TextColor="{StaticResource Gray500}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Button x:Name="CloseButton"
                    Text="Aceptar"
                    FontFamily="BalooRegular"
                    FontSize="15"
                    CornerRadius="14"
                    Padding="16,12"
                    TextColor="White"
                    BackgroundColor="{StaticResource ButtonsGreen}"
                    Margin="0,20,0,0"
                    Clicked="OnCloseClicked" />

        </VerticalStackLayout>
    </Border>

</toolkit:Popup>
