<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Para instalar las actualizaciones que se bajan de GitHub Releases. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        Sin usesCleartextTraffic: el API es HTTPS. Para apuntar a una API local por http
        hay una configuracion de red solo para debug en src/debug.

        allowBackup="false": los datos viven en la nube y se bajan al iniciar sesion;
        restaurar una base o una sesion vieja desde el respaldo de Google solo traeria
        datos desfasados.
    -->
    <application
        android:name=".GastappApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gastapp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Gastapp.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Mensajes del reloj por la Data Layer (mismas rutas que MAUI). Play Services lo
            arranca aunque la app este cerrada. Solo entrega entre apps con el mismo
            applicationId y la misma firma.
        -->
        <service
            android:name=".wear.PhoneWearListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/gastapp"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- Para abrir el APK de actualizacion descargado (misma autoridad que en MAUI). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.binc.gastapp.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            WorkManager se configura en GastappApplication (Configuration.Provider) para
            que el SyncWorker reciba dependencias de Hilt: se quita su inicializador
            automatico.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
